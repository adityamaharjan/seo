# ---- Application ----
APP_NAME="SEO Analysis API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Database (MySQL) ----
DB=seo
DBUser=seo_admin
DBPassword=change_me
DBPort=3306
DB_HOST=localhost
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Redis / ARQ ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- User-supplied API keys (BYOK) ----
# Encrypts each user's provider API keys at rest. Leave empty and key storage
# is refused outright rather than falling back to plaintext, so PageSpeed
# Insights features stay unavailable until this is set.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes stored keys unreadable; users simply re-enter them.
API_KEY_ENCRYPTION_KEY=

# ---- Quota (free tier) ----
FREE_DAILY_LIMIT=5
FREE_MONTHLY_LIMIT=100

# ---- Rate limiting (unauthenticated endpoints; uses the Redis above) ----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600

# ---- Retention (nightly purge run by the worker at 03:17 UTC) ----
REPORT_RETENTION_DAYS=90
TOKEN_RETENTION_DAYS=7

# ---- CORS (comma-separated origins) ----
# Only needed when the frontend is hosted on a different domain than the API.
# A wildcard is refused when ENVIRONMENT=production: credentials are allowed,
# so "*" reflects back whatever origin asks. List your frontend origins.
CORS_ORIGINS=*
# CORS_ORIGINS=https://seo-frontend.vercel.app,https://seo-frontend.pages.dev

# Anchored regex for origins that cannot be listed literally, such as the
# per-branch preview URLs Vercel and Cloudflare Pages generate. Must start with
# ^ and end with $. A pattern matched here is trusted exactly as much as one
# listed above, so keep it tight.
# CORS_ORIGIN_REGEX=^https://seo-frontend-[a-z0-9-]+\.vercel\.app$

# Response headers a cross-origin browser is allowed to read. Retry-After
# carries the quota and rate-limit reset time; drop it and the frontend can see
# a 429 but not when to try again.
CORS_EXPOSE_HEADERS=Retry-After,X-Request-ID,X-Process-Time-ms

# ---- SEO engine ----
SEO_TIMEOUT_SECONDS=15
SEO_MAX_PAGE_BYTES=5000000
SEO_MAX_BROKEN_LINK_CHECKS=25
SEO_MAX_REDIRECTS=10
# Allows analyzing private/localhost addresses. Turning this on in production
# lets any user make the server fetch your internal network.
SEO_ALLOW_PRIVATE_TARGETS=false

# ---- Site audit (multi-page crawl) ----
# Hard ceiling on pages per crawl; the submit form offers choices up to this.
SITE_AUDIT_MAX_PAGES=50
SITE_AUDIT_DEFAULT_PAGES=10
# Pages analyzed at once. Each is a full analysis with its own outbound
# requests, so this multiplies the load one audit puts on the target host.
SITE_AUDIT_CONCURRENCY=4
# Whole-crawl budget, so a slow host cannot occupy a worker indefinitely.
SITE_AUDIT_TIMEOUT_SECONDS=900
SITE_AUDIT_MAX_SITEMAPS=10
# Links probed per page during a crawl. The single-page default (25) would
# multiply by page concurrency into ~100 simultaneous requests at one host.
SITE_AUDIT_BROKEN_LINK_CHECKS=5
