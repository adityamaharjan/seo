{
  "name": "seo-analysis-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Frontend for the SEO Analysis API. Builds to static files in dist/.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
