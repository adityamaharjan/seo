# Where the API lives, as seen by the browser.
#
# Leave this unset for the same-origin deployment: the app then calls /api/v1
# relative to whatever host serves it, which is what the nginx config in
# deploy/ sets up. Set it only if you host the frontend on a different domain
# than the API, in which case you must also add that domain to CORS_ORIGINS on
# the API side.
# VITE_API_BASE_URL=https://seo.hakezlabs.qzz.io/api/v1

# Development only: where `npm run dev` proxies /api to.
VITE_DEV_API_TARGET=http://127.0.0.1:8001
