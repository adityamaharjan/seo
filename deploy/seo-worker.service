[Unit]
Description=ARQ background worker for SEO analyses
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/seo
ExecStart=/var/www/seo/.seo/bin/arq app.workers.settings.WorkerSettings
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
